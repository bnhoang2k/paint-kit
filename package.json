{
  "name": "paint-kit",
  "version": "0.1.2",
  "description": "Paint web surfaces in WebGL2 that look made, not generated.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=26" },
  "bin": { "paint-kit": "./dist/src/cli/paint-kit.js" },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:pages": "pnpm build && vitest run -c vitest.pages.config.ts",
    "test:pages:steps": "node scripts/test-pages.mjs"
  },
  "peerDependencies": { "playwright": "^1.64.0" },
  "peerDependenciesMeta": { "playwright": { "optional": true } },
  "devDependencies": {
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
